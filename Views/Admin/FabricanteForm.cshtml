@model FabricanteFormViewModel
@{
    ViewData["Title"] = Model.Edicao ? "Editar fábrica" : "Nova fábrica";
    var acao = Model.Edicao ? "EditarFabricante" : "NovoFabricante";
}
<div class="container-site flex flex-col gap-8 py-10 lg:flex-row">
    <partial name="_AdminNav" />

    <div class="min-w-0 max-w-2xl flex-1">
        <a asp-action="Fabricantes" class="inline-flex items-center gap-1.5 text-sm text-tecnico hover:text-white"><i data-lucide="arrow-left" class="h-4 w-4"></i> Fábricas</a>
        <h1 class="mt-3 text-5xl font-extrabold uppercase text-white">@ViewData["Title"]</h1>

        <form asp-action="@acao" asp-route-id="@(Model.Edicao ? Model.Id.ToString() : null)" method="post" class="cartao mt-8 space-y-5 p-6" novalidate>
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly"></div>
            <div>
                <label asp-for="NomeFabrica" class="rotulo"></label>
                <input asp-for="NomeFabrica" class="campo" />
                <span asp-validation-for="NomeFabrica"></span>
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="PaisOrigem" class="rotulo"></label>
                    <input asp-for="PaisOrigem" class="campo" />
                    <span asp-validation-for="PaisOrigem"></span>
                </div>
                <div>
                    <label asp-for="CertificacaoISO" class="rotulo"></label>
                    <input asp-for="CertificacaoISO" class="campo" placeholder="Ex.: IATF 16949" />
                    <span asp-validation-for="CertificacaoISO"></span>
                </div>
            </div>
            <label class="flex items-center gap-2.5 text-sm text-white/90">
                <input asp-for="SeloHomologado" class="caixa-selecao" />
                @Html.DisplayNameFor(m => m.SeloHomologado)
            </label>
            <div class="flex gap-2 pt-2">
                <button type="submit" class="btn-primario"><i data-lucide="save"></i> Salvar</button>
                <a asp-action="Fabricantes" class="btn-fantasma">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
