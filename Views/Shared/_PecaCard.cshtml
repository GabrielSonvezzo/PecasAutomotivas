@model PecaCardViewModel
<article class="cartao-interativo group flex flex-col overflow-hidden">
    <a asp-controller="Catalogo" asp-action="Detalhes" asp-route-id="@Model.Id" class="relative block aspect-[4/3] overflow-hidden bg-carbon-800 fundo-grade">
        @if (!string.IsNullOrEmpty(Model.ImagemUrl))
        {
            <img src="@Url.Content(Model.ImagemUrl)" alt="@Model.Nome" loading="lazy" decoding="async"
                 class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" />
        }
        else
        {
            <span class="flex h-full w-full items-center justify-center text-carbon-600">
                <i data-lucide="@UiHelper.IconeCategoria(Model.Categoria)" class="h-16 w-16"></i>
            </span>
        }

        @if (Model.PercentualEconomia > 0)
        {
            <span class="absolute left-3 top-3 etiqueta-lote">
                <i data-lucide="trending-down" class="h-3.5 w-3.5"></i>
                @Formatacao.Percentual(Model.PercentualEconomia) mais barato
            </span>
        }
        @if (!Model.Disponivel)
        {
            <span class="absolute right-3 top-3 selo-vermelho bg-carbon-950/80">Esgotado</span>
        }
    </a>

    <div class="flex flex-1 flex-col p-5">
        <div class="mb-2 flex flex-wrap items-center gap-2 text-xs text-tecnico">
            <span class="inline-flex items-center gap-1">
                <i data-lucide="@UiHelper.IconeCategoria(Model.Categoria)" class="h-3.5 w-3.5 text-laranja"></i>
                @Model.Categoria.NomeExibicao()
            </span>
            <span aria-hidden="true">·</span>
            <span class="font-semibold text-white/80">@Model.Fabricante</span>
        </div>

        <h3 class="text-lg font-bold leading-snug text-white">
            <a asp-controller="Catalogo" asp-action="Detalhes" asp-route-id="@Model.Id" class="hover:text-laranja">@Model.Nome</a>
        </h3>

        <dl class="mt-3 space-y-1.5 text-sm">
            <div class="flex gap-2">
                <dt class="text-tecnico">Código OEM</dt>
                <dd class="font-semibold tracking-wide text-white">@Model.CodigoOEM</dd>
            </div>
            <div class="flex gap-2">
                <dt class="sr-only">Compatibilidade</dt>
                <dd class="flex items-start gap-1.5 text-tecnico">
                    <i data-lucide="car" class="mt-0.5 h-4 w-4"></i>
                    <span>@Model.Compatibilidade</span>
                </dd>
            </div>
        </dl>

        @if (Model.FabricanteHomologado && !string.IsNullOrEmpty(Model.NumeroLote))
        {
            <p class="mt-3">
                <span class="selo-laranja"><i data-lucide="badge-check"></i> Lote certificado de fábrica</span>
            </p>
        }

        <div class="mt-auto pt-5">
            <div class="flex items-end justify-between gap-3">
                <div>
                    <p class="preco-riscado"><span class="sr-only">Preço de concessionária: </span>@Formatacao.Moeda(Model.PrecoConcessionaria)</p>
                    <p class="preco-fabrica mt-1"><span class="sr-only">Preço direto da fábrica: </span>@Formatacao.Moeda(Model.PrecoFabrica)</p>
                </div>
                @if (Model.Economia > 0)
                {
                    <p class="text-right text-xs text-emerald-300">economize<br /><strong class="text-sm">@Formatacao.Moeda(Model.Economia)</strong></p>
                }
            </div>

            @if (Model.Disponivel)
            {
                <a asp-controller="Pedidos" asp-action="Checkout" asp-route-pecaId="@Model.Id" class="btn-primario mt-4 w-full">
                    <i data-lucide="shopping-cart"></i> Comprar direto da fábrica
                </a>
            }
            else
            {
                <a asp-controller="Catalogo" asp-action="Detalhes" asp-route-id="@Model.Id" class="btn-secundario mt-4 w-full">Ver detalhes</a>
            }
        </div>
    </div>
</article>
