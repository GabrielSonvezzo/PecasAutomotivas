@{
    var acao = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    string Classe(params string[] acoes) => acoes.Contains(acao, StringComparer.OrdinalIgnoreCase)
        ? "flex items-center gap-2.5 rounded-lg bg-laranja/10 px-3 py-2 text-sm font-semibold text-laranja"
        : "flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium text-tecnico hover:bg-white/5 hover:text-white";
}
<aside class="lg:w-60 lg:shrink-0">
    <div class="cartao p-4 lg:sticky lg:top-24">
        <div class="mb-4 border-b border-white/[0.06] pb-4">
            <!-- INSERIR LOGO PEÇAS AUTOMOTIVAS AQUI -->
            <partial name="_Logo" />
            <p class="mt-3 text-xs font-semibold text-laranja">Painel administrativo</p>
        </div>
        <nav class="flex gap-1 overflow-x-auto lg:flex-col" aria-label="Menu do painel">
            <a asp-controller="Admin" asp-action="Dashboard" class="@Classe("Dashboard")"><i data-lucide="gauge" class="h-4 w-4"></i> Dashboard</a>
            <a asp-controller="Admin" asp-action="Pedidos" class="@Classe("Pedidos")"><i data-lucide="clipboard-list" class="h-4 w-4"></i> Pedidos</a>
            <a asp-controller="Admin" asp-action="Pecas" class="@Classe("Pecas", "NovaPeca", "EditarPeca")"><i data-lucide="package" class="h-4 w-4"></i> Peças e estoque</a>
            <a asp-controller="Admin" asp-action="Fabricantes" class="@Classe("Fabricantes", "NovoFabricante", "EditarFabricante")"><i data-lucide="factory" class="h-4 w-4"></i> Fábricas</a>
            <a asp-controller="Historico" asp-action="Index" class="@Classe()"><i data-lucide="package-check" class="h-4 w-4"></i> Histórico público</a>
        </nav>
    </div>
</aside>
