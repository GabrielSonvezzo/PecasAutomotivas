@{
    var codigo = ViewData["Codigo"] as int? ?? 500;
    var (titulo, texto) = codigo switch
    {
        404 => ("Página não encontrada", "O endereço não existe ou a peça foi retirada do catálogo."),
        403 => ("Acesso negado", "Você não tem permissão para acessar esta área."),
        400 => ("Requisição inválida", "Não foi possível processar o envio. Recarregue a página e tente de novo."),
        429 => ("Muitas tentativas", "Aguarde um minuto antes de tentar novamente."),
        _ => ("Algo deu errado", "Tivemos um problema ao processar sua solicitação. Tente novamente em instantes.")
    };
    ViewData["Title"] = titulo;
    var requestId = ViewData["RequestId"] as string;
}
<section class="container-site flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <span class="etiqueta-lote text-sm">Erro @codigo</span>
    <h1 class="mt-6 text-5xl font-extrabold uppercase text-white">@titulo</h1>
    <p class="mt-3 max-w-md text-tecnico">@texto</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a asp-controller="Home" asp-action="Index" class="btn-primario"><i data-lucide="house"></i> Página inicial</a>
        <a asp-controller="Catalogo" asp-action="Index" class="btn-secundario">Catálogo de fábrica</a>
    </div>
    @if (codigo >= 500 && !string.IsNullOrEmpty(requestId))
    {
        <p class="mt-8 text-xs text-tecnico">Código de suporte: @requestId</p>
    }
</section>
