{
  "name": "pecas-automotivas",
  "version": "1.0.0",
  "description": "Build do Tailwind CSS da plataforma PEÇAS AUTOMOTIVAS",
  "scripts": {
    "css:build": "tailwindcss -c tailwind.config.js -i ./Styles/input.css -o ./wwwroot/css/site.css --minify",
    "css:watch": "tailwindcss -c tailwind.config.js -i ./Styles/input.css -o ./wwwroot/css/site.css --watch"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "jquery": "^3.7.1",
    "jquery-validation": "^1.21.0",
    "jquery-validation-unobtrusive": "^4.0.0",
    "lucide": "^0.460.0"
  },
  "private": true
}